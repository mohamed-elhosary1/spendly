# Spendly Environment Configuration Example
# Copy this file to .env.local to configure your Supabase backend

# 1. Supabase Project URL (e.g., https://your-project-id.supabase.co)
VITE_SUPABASE_URL=

# 2. Supabase Anon (Public) Key
# Never use the service-role key on the client!
VITE_SUPABASE_ANON_KEY=

# Optional: Default currency (EGP, USD, EUR, SAR, AED, GBP)
VITE_DEFAULT_CURRENCY=EGP
